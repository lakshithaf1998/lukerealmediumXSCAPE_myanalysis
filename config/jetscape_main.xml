<?xml version='1.0' encoding='utf-8'?>
<jetscape>

  
  <nEvents> 1 </nEvents>
  <setReuseHydro> false </setReuseHydro>
  <nReuseHydro> 1 </nReuseHydro>

  
  <debug> off </debug>
  <remark> off </remark>
  <vlevel> 0 </vlevel>
  <nEvents_printout> 100 </nEvents_printout>
  <enableAutomaticTaskListDetermination> true </enableAutomaticTaskListDetermination>

  
  <outputFilename>test_out</outputFilename>
  <JetScapeWriterAscii> off </JetScapeWriterAscii>
  <JetScapeWriterAsciiGZ> off </JetScapeWriterAsciiGZ>
  <JetScapeWriterHepMC> off </JetScapeWriterHepMC>
  <JetScapeWriterRootHepMC> off </JetScapeWriterRootHepMC>
  <JetScapeWriterFinalStatePartonsAscii> off </JetScapeWriterFinalStatePartonsAscii>
  <JetScapeWriterFinalStateHadronsAscii> on </JetScapeWriterFinalStateHadronsAscii>
  <JetScapeWriterQnVectorAscii>off</JetScapeWriterQnVectorAscii>
  <QnVector_pTmin>0</QnVector_pTmin>
  <QnVector_pTmax>6</QnVector_pTmax>
  <QnVector_NpT>30</QnVector_NpT>
  <QnVector_rapmin>-4</QnVector_rapmin>
  <QnVector_rapmax>4</QnVector_rapmax>
  <QnVector_Nrap>80</QnVector_Nrap>
  <QnVector_Norder>7</QnVector_Norder>
  
  <write_centrality> 0 </write_centrality>
  <write_pthat> 0 </write_pthat>
  <Writer>
    
    
    <FinalStateHadrons>
       <statusToSkip>-9999</statusToSkip>
       <headerVersion>2</headerVersion>
    </FinalStateHadrons>
    <FinalStatePartons>
       <statusToSkip>-9999</statusToSkip>
       <headerVersion>2</headerVersion>
    </FinalStatePartons>
    
    <JetscapeWriterFinalStateBinaryOutput> 0 </JetscapeWriterFinalStateBinaryOutput>
  </Writer>

  
  
  
  
  
  <Random>
    <seed>0</seed>
  </Random>

  
  <BDM>
    
    
    <energy_density_criterion>0</energy_density_criterion>
    <Tc>0.155</Tc>
    <ec>0.35</ec>
    <IC_particle_extraction_tau>0.5</IC_particle_extraction_tau>
    
    <pT_cut>0.0</pT_cut>
    <rapidity_cut>0.0</rapidity_cut>
    
    <ignore_spectator_hadrons>0</ignore_spectator_hadrons>
    
    <CreateHadronicTimeEvolutionOutput> false </CreateHadronicTimeEvolutionOutput>
  </BDM>

  
  <IS>
    
    
    
    
    <grid_max_x> 15 </grid_max_x>
    <grid_max_y> 15 </grid_max_y>
    <grid_max_z> 0  </grid_max_z>
    <grid_step_x> 0.3 </grid_step_x>
    <grid_step_y> 0.3 </grid_step_y>
    <grid_step_z> 0.2 </grid_step_z>

    <Trento>
    <PhysicsInputs projectile="Pb" target="Pb" sqrts="2760" cross-section="6.4" normalization="13.9">
    </PhysicsInputs>
    <CutInputs centrality-low="50" centrality-high="60">
    </CutInputs>
    <TransInputs reduced-thickness="0.0" fluctuation="1.2" nucleon-width="0.9" nucleon-min-dist="1.2">
    </TransInputs>
    <LongiInputs mean-coeff="1.0" std-coeff="3.0" skew-coeff="0.0" skew-type="1" jacobian="0.8">
    </LongiInputs>
    </Trento>

    
    <initial_profile_path>../examples/test_hydro_files</initial_profile_path>
    <initial_Ncoll_list>../examples/test_hydro_files</initial_Ncoll_list>

    <MCGlauber>
      
      
      <generateOnlyPositions>0</generateOnlyPositions>
      
      <projectile>p</projectile> 
      <target>p</target> 
      <sqrts>13000</sqrts> 
      <b_min>0.0</b_min> 
      <b_max>20.0</b_max> 
      <cenMin>0.0</cenMin> 
      <cenMax>100.0</cenMax> 
      <nucleon_configuration_from_file>0</nucleon_configuration_from_file> 
      <useQuarks>1</useQuarks> 
      <Q2>1.0</Q2> 
      <shadowing_factor>0.6</shadowing_factor> 
      <baryon_junctions>1</baryon_junctions> 
      <N_sea_partons>1</N_sea_partons> 
      <d_min>0.9</d_min> 
      <lambdaB>0.2</lambdaB> 
      <BG>5.0</BG> 
      <Subtract_hard_momentum>1</Subtract_hard_momentum>
      <lambdaBs>0.0</lambdaBs> 
      <baryonInStringProb>0.2</baryonInStringProb> 
      <fluct_Nstrings_per_NN_collision>1</fluct_Nstrings_per_NN_collision> 
      <QCD_string_production_mode>1</QCD_string_production_mode> 
      
      <rapidity_loss_method>4</rapidity_loss_method>
      <ylossParam4At2>1.60</ylossParam4At2>
      <ylossParam4At4>2.15</ylossParam4At4>
      <ylossParam4At6>2.45</ylossParam4At6>
      <ylossParam4At10>2.95</ylossParam4At10>
      <ylossParam4var>0.5</ylossParam4var>
      <remnant_energy_loss_fraction>0.5</remnant_energy_loss_fraction> 
      <fluctuation_remnant_energy_loss_fraction>0</fluctuation_remnant_energy_loss_fraction>
      <remnant_energy_loss_fraction_var>0.4</remnant_energy_loss_fraction_var>
      
      
      
      
      
      <evolve_QCD_string_mode>4</evolve_QCD_string_mode>
      <tau_form_mean>0.5</tau_form_mean> 
      <tau_form_fluct_gamma_beta>1.0</tau_form_fluct_gamma_beta> 
    </MCGlauber>

    <SMASH>
      <SMASH_config_file>../external_packages/smash/smash_config_initial_condition.yaml</SMASH_config_file>
      <SMASH_particles_file>../external_packages/smash/smash_code/input/particles.txt</SMASH_particles_file>
      <SMASH_decaymodes_file>../external_packages/smash/smash_code/input/decaymodes.txt</SMASH_decaymodes_file>

      <ProjectileProtons>79</ProjectileProtons>
      <ProjectileNeutrons>118</ProjectileNeutrons>
      <TargetProtons>79</TargetProtons>
      <TargetNeutrons>118</TargetNeutrons>

      
      
      <end_time>1000.0</end_time>
      <Sqrtsnn>200.0</Sqrtsnn>
      
      <FermiMotion>frozen</FermiMotion>
      <CollisionsWithinNucleus>0</CollisionsWithinNucleus>
      <Impact>
        <RandomReactionPlane>0</RandomReactionPlane>
        
        
        
        <Mode>0</Mode>
        <Value>0.0</Value>
        <Sample>quadratic</Sample>
        <ImpactMin>0.0</ImpactMin>
        <ImpactMax>3.0</ImpactMax>
      </Impact>
      
      <Delta_Time>0.01</Delta_Time>
    </SMASH>

    
    <SMASHNucleus>
      <SMASH_config_file>../external_packages/smash/smash_config_nucleus.yaml</SMASH_config_file>
      <SMASH_particles_file>../external_packages/smash/smash_code/input/particles.txt</SMASH_particles_file>
      <SMASH_decaymodes_file>../external_packages/smash/smash_code/input/decaymodes.txt</SMASH_decaymodes_file>
      <Protons>82</Protons>
      <Neutrons>126</Neutrons>
      <FermiMomenta>0</FermiMomenta>
      
      <NucleonRadiusBlackDisk>0.6</NucleonRadiusBlackDisk>
    </SMASHNucleus>

    
    <IPGlasma> </IPGlasma>
  </IS>

  
  <Hard>

    
    <PGun>
      <name>PGun</name>
      <pT>100</pT>
      <parID>21</parID>
    </PGun>

    
    
    <PythiaGun>
      <name>PythiaGun</name>
      <FSR_on>0</FSR_on>
      <pTHatMin>100</pTHatMin>
      <pTHatMax>120</pTHatMax>
      <useHybridHad> 0 </useHybridHad>
      <eCM>13000</eCM>
      
      <softMomentumCutoff>2.0</softMomentumCutoff>
      
      
      <LinesToRead>
      	HardQCD:all = on
      </LinesToRead>
    </PythiaGun>

    <epemGun>
      <name>epemgun</name>
      <eCM>5020</eCM>
      
      
      <LinesToRead>
        HadronLevel::all = off
      </LinesToRead>
    </epemGun>

    <EPGun>
      <name>EPGun</name>
      <electron_energy>27.5</electron_energy>
      <proton_energy>920</proton_energy>
      <Q2_pow>1.7</Q2_pow>
      <Q2_factor>500</Q2_factor>
      <Q2min>0</Q2min>
      <Q2max>1000000</Q2max>
      <W2min>0</W2min>
      <W2max>1000000</W2max>
      <xmin>0</xmin>
      <xmax>1</xmax>
      <ymin>0</ymin>
      <ymax>1</ymax>
      <FSR_on>0</FSR_on>
      
      <softMomentumCutoff>0.0</softMomentumCutoff>
      <use_positron>0</use_positron>
      <photoproduction>0</photoproduction>
      <breit_vir>1</breit_vir>
    </EPGun>
  </Hard>

  
  
  
  <Eloss>

    <deltaT>0.1</deltaT>
    <formTime> -0.1</formTime>
    <maxT>20</maxT>
    <tStart> 0.6 </tStart> 
    <mutex>ON</mutex>
    <AddLiquefier> false </AddLiquefier>
    <ModificationFactor> -1 </ModificationFactor> 
    <lambdaQCD>0.2</lambdaQCD> 

    <Matter>
      <name>Matter</name>
      <matter_on> 1 </matter_on>
      <Q0> 2.0 </Q0>
      <QS> 0.9 </QS>
      <T0> 0.16 </T0>
      
      <initial_virtuality_pT> 1 </initial_virtuality_pT>
      <vir_factor> 0.25 </vir_factor>
      <in_vac> 1 </in_vac>
      <recoil_on> 0 </recoil_on>
      <broadening_on> 0 </broadening_on>
      <brick_med> 0 </brick_med>   
      <useHybridHad> 0 </useHybridHad>
      <brick_length> 5.0 </brick_length>
      <hydro_Tc> 0.16 </hydro_Tc>
      
      
      
      
      
      
      
      
      
      <QhatParametrizationType> 0 </QhatParametrizationType>
      <qhat0> -2.0 </qhat0>  
      <alphas> 0.25 </alphas>
      <qhatA> 10.0 </qhatA>    
      <qhatB> 10.0 </qhatB>    
      <qhatC> 1.0 </qhatC>    
      <qhatD> 0.0 </qhatD>    
    </Matter>

    <Lbt>
      <name> Lbt </name>
      <Q0> 2.0 </Q0>
      <in_vac> 0 </in_vac>
      <only_leading> 0 </only_leading>
      <hydro_Tc> 0.16 </hydro_Tc>
      <alphas> 0.2 </alphas>
      <run_alphas>1</run_alphas>   
    </Lbt>

    <Martini>
      <name> Martini </name>
      <Q0> 2.0 </Q0>
      <alpha_s> 0.3 </alpha_s>
      <pcut> 2.0 </pcut>
      <hydro_Tc> 0.16 </hydro_Tc>
      <recoil_on> 0 </recoil_on>
      <run_alphas>1</run_alphas>
      <path>../src/jet/Martini/</path>
    </Martini>

    <AdSCFT>
      <name> AdSCFT </name>
      <kappa> 0.36 </kappa>
      <T0> 0.16 </T0>
      <Q0> 2.0 </Q0>
      <in_vac> 0 </in_vac>
    </AdSCFT>

  </Eloss>

  <PartonPrinter>
      <Status>off</Status>
      <FileName>./FinalPartonsInfo.dat</FileName>
  </PartonPrinter>

  
  <Preequilibrium>

    
    <tau0>0.0</tau0>
    
    <tauj>0.1</tauj>
    
    <taus>0.5</taus>
    <evolutionInMemory>1</evolutionInMemory>

    
    <FreestreamMilne>
      <name>FreestreamMilne</name>
      <freestream_input_file>freestream_input</freestream_input_file>
      
      
      <ntau>50</ntau>

      
      
      
      <E_DEP_FS>0</E_DEP_FS>
      
      <E_R>4.0</E_R>
      
      <TAU_R>1.46</TAU_R>
      
      <ALPHA>0.031</ALPHA>
    </FreestreamMilne>

    
    
    
    <Glasma>
      <tau0>0.001</tau0>
      <taus>0.4</taus>
      <dtau>0.005</dtau>
      <input_filename_glasma>./epsilon-u-Hydro-t0.4-0.dat</input_filename_glasma>
    </Glasma>

    <NullPreDynamics> </NullPreDynamics>

  </Preequilibrium>


  
  <Liquefier>
      
      <threshold_energy_switch>1</threshold_energy_switch>
      <e_threshold>2.0</e_threshold>

      
      <CausalLiquefier>
          <name>CausalLiquefier</name>
          <dtau>0.02</dtau>
          <dx>0.3</dx>
          <dy>0.3</dy>
          <deta>0.2</deta>
          <tau_delay>2.0</tau_delay>
          <time_relax>0.1</time_relax>
          <d_diff>0.08</d_diff>
          <width_delta>0.1</width_delta>
      </CausalLiquefier>

      
      <HadronicLiquefier>
          <name>HadronicLiquefier</name>
          <covariant_kernel>1</covariant_kernel> 
          <sigma_transverse>0.5</sigma_transverse> 
          <sigma_longitudinal>0.5</sigma_longitudinal> 
          <gamma_factor_max>100.0</gamma_factor_max> 
      </HadronicLiquefier>
  </Liquefier>

  
  
  <Hydro>

    <AddLiquefier> false </AddLiquefier>
    <CartesianHydro> false </CartesianHydro>

    
    <Brick bjorken_expansion_on="false" start_time="0.6">
      <name>Brick</name>
      <T>0.2</T>
      <v_x>0.0</v_x>
      <v_y>0.0</v_y>
      <v_z>0.0</v_z>
    </Brick>

    
    <Gubser>
    </Gubser>

    
    <hydro_from_file>
      <name>Hydro from file </name>
      <read_in_multiple_hydro>1</read_in_multiple_hydro>
      <hydro_files_folder>../examples/test_hydro_files</hydro_files_folder>

      
      
      
      <hydro_type>1</hydro_type>

      <boost_invariant_>1</boost_invariant_>
      
      <VISH_file>../examples/test_hydro_files/VISH_evo.h5</VISH_file>
      
      
      <load_viscous_info>0</load_viscous_info>

       
      <PreEq_file>../examples/test_hydro_files/evolution_all_xyeta_fs.dat</PreEq_file>

      
      
      <MUSIC_input_file>../examples/test_hydro_files/MUSIC_input</MUSIC_input_file>
      <MUSIC_file>../examples/test_hydro_files/MUSIC_evo.dat</MUSIC_file>
      
      <T_c>0.154</T_c>

      
      
      <read_hydro_every_ntau>1</read_hydro_every_ntau>
    </hydro_from_file>

    
    <MUSIC>
      <name>MUSIC</name>
      <MUSIC_input_file>music_input</MUSIC_input_file>
      
      <EOS>91</EOS>
      
      <InitialProfile>42</InitialProfile>
      
      
      
      <beastMode>0</beastMode>
      
      <Initial_time_tau_0>0.6</Initial_time_tau_0>
      
      <output_evolution_to_file>0</output_evolution_to_file>
      <store_hydro_info_in_memory> 0 </store_hydro_info_in_memory>
      <output_evolution_to_memory>1</output_evolution_to_memory>
      
      <output_evolution_every_N_timesteps>1</output_evolution_every_N_timesteps>
      <surface_in_memory>1</surface_in_memory>
      
      <shear_viscosity_eta_over_s>0.08</shear_viscosity_eta_over_s>
      <T_dependent_Shear_to_S_ratio>3</T_dependent_Shear_to_S_ratio>
      
      <shear_viscosity_2_curv>-0.48</shear_viscosity_2_curv>
      <shear_viscosity_2_slope>1.11</shear_viscosity_2_slope>
      <shear_viscosity_2_min>0.081</shear_viscosity_2_min>
      
      <shear_viscosity_3_T_kink_in_GeV>0.16</shear_viscosity_3_T_kink_in_GeV>
      <shear_viscosity_3_at_kink>0.08</shear_viscosity_3_at_kink>
      <shear_viscosity_3_low_T_slope_in_GeV>0</shear_viscosity_3_low_T_slope_in_GeV>
      <shear_viscosity_3_high_T_slope_in_GeV>0</shear_viscosity_3_high_T_slope_in_GeV>
      
      <muB_dependent_Shear_to_S_ratio>0</muB_dependent_Shear_to_S_ratio>
      
      
      <shear_7_muBf0p2>-1</shear_7_muBf0p2>
      <shear_7_muBf0p4>-1</shear_7_muBf0p4>
      
      <shear_10_muBDep_alpha>0.7</shear_10_muBDep_alpha>
      <shear_10_muBDep_slope>2.0</shear_10_muBDep_slope>
      <shear_10_muBDep_scale>0.6</shear_10_muBDep_scale>
      
      <temperature_dependent_bulk_viscosity>3</temperature_dependent_bulk_viscosity>
      
      <bulk_viscosity_2_normalisation>0.052</bulk_viscosity_2_normalisation>
      <bulk_viscosity_2_width_in_GeV>0.022</bulk_viscosity_2_width_in_GeV>
      <bulk_viscosity_2_peak_in_GeV>0.183</bulk_viscosity_2_peak_in_GeV>
      
      <bulk_viscosity_3_max>0.06</bulk_viscosity_3_max>
      <bulk_viscosity_3_T_peak_in_GeV>0.17</bulk_viscosity_3_T_peak_in_GeV>
      <bulk_viscosity_3_width_in_GeV>0.02</bulk_viscosity_3_width_in_GeV>
      <bulk_viscosity_3_lambda_asymm>0.1</bulk_viscosity_3_lambda_asymm>
      
      <bulk_viscosity_10_max>0.10</bulk_viscosity_10_max>
      
      <bulk_viscosity_10_max_muB0p4>-1</bulk_viscosity_10_max_muB0p4>
      <bulk_viscosity_10_max_muB0p2>-1</bulk_viscosity_10_max_muB0p2>
      <bulk_viscosity_10_width_high>0.08</bulk_viscosity_10_width_high>
      <bulk_viscosity_10_width_low>0.010</bulk_viscosity_10_width_low>
      <bulk_viscosity_10_T_peak>0.17</bulk_viscosity_10_T_peak>
      <bulk_viscosity_10_T_peak_muBcurv>-0.15</bulk_viscosity_10_T_peak_muBcurv>
      
      <Include_second_order_terms>1</Include_second_order_terms>
      
      <Include_Rhob>0</Include_Rhob>
      <Include_QS>0</Include_QS>
      
      <use_eps_for_freeze_out>0</use_eps_for_freeze_out>
      <freezeout_temperature>0.15</freezeout_temperature>
      <eps_switch>0.3</eps_switch>
      <Do_FreezeOut_lowtemp>1</Do_FreezeOut_lowtemp>
      <average_surface_over_this_many_time_steps>5</average_surface_over_this_many_time_steps>
      
      <Perform_CooperFrye_Freezeout>0</Perform_CooperFrye_Freezeout>
      
      <string_source_sigma_x>0.5</string_source_sigma_x>
      <string_source_sigma_eta>0.5</string_source_sigma_eta>
      <stringPreEqFlowFactor>0.13</stringPreEqFlowFactor>
    </MUSIC>

    
    <CLVisc>
      <name>CLVisc</name>
      <cpu_block_size>1</cpu_block_size>
      <gpu_block_size>64</gpu_block_size>
      <device_type>gpu</device_type>
      <device_id> 0 </device_id>
      <etaos_xmin> 0.15 </etaos_xmin>
      <etaos_ymin> 0.08 </etaos_ymin>
      <etaos_left_slop> 0.0 </etaos_left_slop>
      <etaos_right_slop> 0.0 </etaos_right_slop>
      <tau0> 0.6 </tau0>
      
      <ntau_skip> 10 </ntau_skip>
      <nx_skip> 2 </nx_skip>
      <ny_skip> 2 </ny_skip>
      <netas_skip> 2 </netas_skip>
      
      <scale_factor> 57 </scale_factor>
      <dtau> 0.02 </dtau>
      <result_directory>./</result_directory>
      <Perform_CooperFrye_Freezeout>0</Perform_CooperFrye_Freezeout>
    </CLVisc>

  </Hydro>

  
   <JetHadronization>
       <name>colored/colorless/hybrid</name>
       <probStoUD>0.6413</probStoUD>
       <take_recoil>1</take_recoil>
       
       
       
       <eCMforHadronization>6500</eCMforHadronization>
       
       <reco_Mlevelmax>1</reco_Mlevelmax>
        
       <reco_Blevelmax>1</reco_Blevelmax>
       
       <reco_goldstone>0</reco_goldstone>
       
       <thermreco_distmax>5.0</thermreco_distmax>
       
       <shower_recofactor>1.0</shower_recofactor>
       
       <thermal_recofactor>1.0</thermal_recofactor>
       
       <recobias_t>0</recobias_t>
       <hydro_Tc>0.16</hydro_Tc>
       <eta_max_boost_inv>2.0</eta_max_boost_inv> 
       
       <had_postprop>0.0</had_postprop>
       
       <part_prop>0.0</part_prop>
       <pythia_decays>on</pythia_decays> 
       <tau0Max>10.0</tau0Max> 
       <weak_decays>depracted</weak_decays> 
       
       
       <LinesToRead>
          Init:showProcesses = off 
       </LinesToRead> 
       <reco_hadrons_in_pythia>1</reco_hadrons_in_pythia>
       
       <additional_pythia_particles>0</additional_pythia_particles>
       
       <additional_pythia_particles_path>../config/HH_LightExcitedMesons.xml</additional_pythia_particles_path>
   </JetHadronization>

  
  <SoftParticlization>
    
    <iSS>
      
      
      
      
      <hydro_mode>1</hydro_mode>

      
      <iSS_input_file>../external_packages/iSS/iSS_parameters.dat</iSS_input_file>
      
      <iSS_working_path>.</iSS_working_path>
      
      <iSS_table_path>../external_packages/iSS/iSS_tables</iSS_table_path>
      
      <iSS_particle_table_path>../external_packages/iSS/iSS_tables</iSS_particle_table_path>
      
      <afterburner_type>2</afterburner_type>

      <include_deltaf_shear>1</include_deltaf_shear>
      <include_deltaf_bulk>1</include_deltaf_bulk>
      
      <deltaf_type>20</deltaf_type>
      <number_of_repeated_sampling>1</number_of_repeated_sampling>
      <Perform_resonance_decays>0</Perform_resonance_decays>
    </iSS>
  </SoftParticlization>

  
  <HadronicEMT>
    <smearing_covariant>1</smearing_covariant> 
    <sigma_transverse>0.5</sigma_transverse>
    <sigma_longitudinal>0.5</sigma_longitudinal>
  </HadronicEMT>

  
  <Afterburner>
    
    <include_fragmentation_hadrons>0</include_fragmentation_hadrons>
    
    
    <output_only_final_state_hadrons>1</output_only_final_state_hadrons>
    
    <SMASH>

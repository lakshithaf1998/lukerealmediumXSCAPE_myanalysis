+void Matter::RecordHydroQuery(double t, double x, double y, double z,
+                              double temperature) {
+  if (in_vac) {
+    return;
+  }
+  hydro_query_count++;
+  hydro_query_temp_sum += temperature;
+  hydro_query_temp_min = std::min(hydro_query_temp_min, temperature);
+  hydro_query_temp_max = std::max(hydro_query_temp_max, temperature);
+  if (temperature >= hydro_Tc) {
+    hydro_query_above_tc++;
+  } else {
+    hydro_query_below_tc++;
+  }
+  if (temperature <= 0.0) {
+    hydro_query_zero_or_negative++;
+  }
+  if (temperature > 0.0) {
+    hydro_query_T_gt_0++;
+  }
+  const bool outside_light_cone = !(t * t > z * z);
+  if (outside_light_cone) {
+    hydro_query_outside_light_cone++;
+  }
+  if (t < tStart) {
+    hydro_query_before_hydro_start++;
+  }
+  if (t >= tStart && temperature <= 0.0) {
+    hydro_query_after_hydro_start_T_le_0++;
+  }
+  if (hydro_query_sample_count < 20) {
+    std::ofstream samples("medium_hydro_query_samples.txt", std::ios::app);
+    if (samples) {
+      double tau = 0.0;
+      double eta = 0.0;
+      if (!outside_light_cone) {
+        tau = std::sqrt(t * t - z * z);
+        eta = 0.5 * std::log((t + z) / (t - z));
+      }
+      samples << "sample " << hydro_query_sample_count << " t " << t
+              << " x " << x << " y " << y << " z " << z << " tau " << tau
+              << " eta " << eta << " T " << temperature
+              << " tStart " << tStart << "\n";
+    }
+    hydro_query_sample_count++;
+  }
+}
+
+void Matter::WriteHydroQueryQA() const {
+  std::ofstream qa("medium_hydro_query_QA.txt", std::ios::app);
+  if (!qa) {
+    return;
+  }
+  const double mean_temp =
+      hydro_query_count > 0
+          ? hydro_query_temp_sum / static_cast<double>(hydro_query_count)
+          : 0.0;
+  const double min_temp =
+      hydro_query_count > 0 ? hydro_query_temp_min : 0.0;
+  const double above_frac =
+      hydro_query_count > 0
+          ? static_cast<double>(hydro_query_above_tc) /
+                static_cast<double>(hydro_query_count)
+          : 0.0;
+  qa << "Matter hydro query QA\n"
+     << "in_vac " << in_vac << "\n"
+     << "hydro_Tc_GeV " << hydro_Tc << "\n"
+     << "queries " << hydro_query_count << "\n"
+     << "queries_T_ge_Tc " << hydro_query_above_tc << "\n"
+     << "queries_T_lt_Tc " << hydro_query_below_tc << "\n"
+     << "queries_T_le_0 " << hydro_query_zero_or_negative << "\n"
+     << "queries_T_gt_0 " << hydro_query_T_gt_0 << "\n"
+     << "queries_before_hydro_start_t " << hydro_query_before_hydro_start
+     << "\n"
+     << "queries_outside_light_cone " << hydro_query_outside_light_cone << "\n"
+     << "queries_after_hydro_start_T_le_0 "
+     << hydro_query_after_hydro_start_T_le_0 << "\n"
+     << "fraction_T_ge_Tc " << above_frac << "\n"
+     << "temperature_min_GeV " << min_temp << "\n"
+     << "temperature_mean_GeV " << mean_temp << "\n"
+     << "temperature_max_GeV " << hydro_query_temp_max << "\n"
+     << "QhatParametrizationType " << QhatParametrizationType << "\n"
+     << "Q0 " << Q00 << "\n"
+     << "qhat0 " << qhat0 << "\n"
+     << "----\n";
+}
